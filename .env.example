# Optional live execution only. Never commit populated credentials.
BENCHMARK_MODEL_ENDPOINT=https://api.openai.com/v1
BENCHMARK_MODEL_NAME=replace-with-explicit-model-snapshot
BENCHMARK_MODEL_API_KEY=replace-with-model-key
BENCHMARK_MODEL_RETRIES=2
VOLC_ACCESS_KEY_ID=replace-with-access-key
VOLC_SECRET_ACCESS_KEY=replace-with-secret-key
SEARCH_FILTER_MODEL_ENDPOINT=https://api.openai.com/v1
SEARCH_FILTER_MODEL_NAME=replace-with-filter-model-snapshot
SEARCH_FILTER_MODEL_API_KEY=replace-with-filter-key
BENCHMARK_FINANCE_SOURCE=/absolute/path/to/pinned/financeharness
BENCHMARK_ODR_SOURCE=/absolute/path/to/pinned/open_deep_research
BENCHMARK_GPT_SOURCE=/absolute/path/to/pinned/gpt_researcher
BENCHMARK_SEARCH_SERVICE_URL=http://127.0.0.1:8765
BENCHMARK_SEARCH_SERVICE_ADMIN_TOKEN_FILE=data/search-service/admin.token

# Optional aliases: ALIYUN_BASE_URL, ALIYUN_MODEL, ALIYUN_API_KEY map to
# BENCHMARK_MODEL_ENDPOINT, BENCHMARK_MODEL_NAME, BENCHMARK_MODEL_API_KEY.
# ALIYUN_TIMEOUT aliases BENCHMARK_MODEL_TIMEOUT (seconds).
# DASHSCOPE_BASE_URL and DASHSCOPE_MODEL are endpoint/model-name string aliases
# for BENCHMARK_MODEL_ENDPOINT and BENCHMARK_MODEL_NAME, respectively.
# DASHSCOPE_API_KEY and BAILIAN_API_KEY alias BENCHMARK_MODEL_API_KEY.
# DASHSCOPE_TIMEOUT aliases BENCHMARK_MODEL_TIMEOUT (positive float seconds),
# as does ALIYUN_TIMEOUT. Non-numeric or non-positive values are rejected.
# Resolution uses the first non-empty value: configured benchmark variable,
# standard BENCHMARK_MODEL_* variable, ALIYUN_*, DASHSCOPE_*, then BAILIAN_API_KEY
# for the API key only. Whitespace is stripped from all alias values.
